<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="750.0" maxWidth="1250.0" minHeight="750.0" minWidth="1250.0" prefHeight="750.0" prefWidth="1250.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.unicam.cs.mpgc.rpg129852.controller.session.ShopController">
   <top>
      <StackPane prefHeight="80.0" prefWidth="1250.0" BorderPane.alignment="CENTER">
         <children>
            <!-- Sezione Sinistra: Pulsante Indietro e Header del Discepolo nella posizione originale -->
            <HBox alignment="CENTER_LEFT" spacing="20.0" StackPane.alignment="CENTER_LEFT">
               <children>
                  <Button fx:id="returnToMenuButton" maxHeight="60.0" maxWidth="60.0" minHeight="60.0" minWidth="60.0" mnemonicParsing="false" onAction="#onBackToMenuButtonClicked" prefHeight="60.0" prefWidth="60.0" styleClass="arrow">
                     <graphic>
                        <Region maxHeight="24.0" maxWidth="24.0" prefHeight="24.0" prefWidth="24.0" styleClass="previous-scene-icon" />
                     </graphic>
                     <HBox.margin>
                        <Insets left="30.0" />
                     </HBox.margin>
                  </Button>
                  <fx:include fx:id="discipleHeader" source="DiscipleHeader.fxml" />
               </children>
            </HBox>

            <!-- Centro della barra superiore: Etichetta delle Virtù -->
            <Label fx:id="currentVirtuesLabel" alignment="CENTER" prefHeight="25.0" prefWidth="443.0" StackPane.alignment="CENTER" />
         </children>
      </StackPane>
   </top>

   <center>
      <StackPane BorderPane.alignment="CENTER">
         <children>
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" maxHeight="549.0" maxWidth="695.0" prefHeight="549.0" prefWidth="695.0">
               <content>
                  <VBox fx:id="booksContainer" alignment="TOP_CENTER" maxWidth="675.0" minWidth="675.0" prefWidth="675.0" spacing="15.0">
                     <padding>
                        <Insets bottom="10.0" top="10.0" />
                     </padding>
                  </VBox>
               </content>
            </ScrollPane>
         </children>
         <padding>
            <Insets bottom="30.0" top="10.0" />
         </padding>
      </StackPane>
   </center>

   <stylesheets>
      <URL value="@../css/Global.css" />
      <URL value="@../css/Shop.css" />
   </stylesheets>
</BorderPane>
